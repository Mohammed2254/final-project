VITE_API_BASE_URL=http://localhost:5000/api

# Cloud name is public by design; the upload preset must be created as
# "Unsigned" in the Cloudinary dashboard (Settings -> Upload -> Add upload
# preset) - see services/cloudinary/upload.ts for why no API secret is needed.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# The publishable key is meant to be public (it only ever tokenizes a card
# in the browser - it can't move money by itself). The secret key never
# goes here; it lives in "back end/.env" only.
VITE_MOYASAR_PUBLISHABLE_KEY=pk_test_your-publishable-key
